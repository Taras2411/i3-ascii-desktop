#!/usr/bin/env python3
"""Restart this user's three widgets after source changes; keep all private state."""
import os
from pathlib import Path
import signal
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
SCRIPTS = ('system-desktop', 'center-desktop', 'prague-weather')
paths = {str(base / 'bin' / name) for base in (ROOT, HOME / '.local') for name in SCRIPTS}
paths.update(str(base / 'share/center-desktop/app.py') for base in (ROOT, HOME / '.local'))
pids = []
for entry in Path('/proc').iterdir():
    if not entry.name.isdigit() or int(entry.name) == os.getpid():
        continue
    try:
        if entry.stat().st_uid != os.getuid():
            continue
        arguments = (entry / 'cmdline').read_bytes().decode().split('\0')
        if any(value in paths for value in arguments[1:]):
            os.kill(int(entry.name), signal.SIGTERM)
            pids.append(int(entry.name))
    except (OSError, UnicodeError):
        continue

def alive(pid):
    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except OSError:
        return False

deadline = time.monotonic() + 4
while any(alive(pid) for pid in pids) and time.monotonic() < deadline:
    time.sleep(.05)
if any(alive(pid) for pid in pids):
    raise SystemExit('A widget did not stop. No replacement instance was started.')
cache = HOME / '.cache/i3-ascii-desktop'
cache.mkdir(parents=True, exist_ok=True, mode=0o700)
fd = os.open(cache / 'restart.log', os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
with os.fdopen(fd, 'a') as log:
    children = [(name, subprocess.Popen([str(HOME / '.local/bin' / name)], cwd=ROOT, stdout=log, stderr=log, start_new_session=True)) for name in SCRIPTS]
    time.sleep(2)
for name, child in children:
    if child.poll() is not None:
        raise SystemExit(f'{name} exited during startup; see {cache / "restart.log"}')
    print(f'{name}: PID {child.pid}')
